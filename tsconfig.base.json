{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@limen/shared/*": ["packages/shared/src/*"],
      "@limen/db/*": ["packages/db/src/*"],
      "@limen/ui/*": ["packages/ui/src/*"]
    }
  }
}
